<%- include('../partials/head', { page }) %>
<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<main class="main-content article-main" id="main-content">
  <div class="article-shell">
    <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/world-ranges">The atlas</a><span>/</span><span><%= page.title %></span></div>
    <header class="article-hero reveal">
      <div class="article-hero-copy"><span class="article-eyebrow"><span class="kicker-line"></span><%= page.eyebrow %></span><h1><%= page.title %></h1><p class="article-deck"><%= page.description %></p><div class="article-meta"><span class="meta-icon">◷</span><%= page.read %><span class="meta-separator"></span><span><%= page.category %></span><span class="meta-separator"></span><span>Mountain Atlas field notes</span></div><div class="article-hero-actions"><a class="text-link" href="#article-body">Start reading <span>↓</span></a><button class="share-button" type="button" data-copy-link>Copy page link <span>↗</span></button></div></div>
      <div class="article-hero-visual"><img src="<%= imageSrc(page.image) %>" data-image-fallback="/img/<%= page.slug %>.svg" alt="Illustrated landscape for <%= page.title %>"><div class="visual-caption"><span>ATLAS COLLECTION</span><strong><%= page.category.toUpperCase() %></strong></div><span class="visual-index">FIELD / <%= page.eyebrow.split('/')[0].trim() %></span></div>
    </header>

    <% if (typeof explorer !== 'undefined' && explorer) { %>
    <section class="elevation-lab reveal" aria-labelledby="elevation-title"><div class="lab-heading"><span class="section-index">INTERACTIVE FIELD LAB</span><h2 id="elevation-title">Climb through the <em>living layers.</em></h2><p>Drag the elevation marker to explore a simplified mountain gradient. Real vegetation zones vary with latitude, moisture, aspect and local geology.</p></div><div class="elevation-widget"><div class="elevation-readout"><div><span class="small-label">CURRENT ELEVATION</span><strong id="elevation-value">2,000 <small>m</small></strong></div><span class="elevation-chip" id="elevation-band">Montane forest</span></div><input type="range" id="elevation-slider" min="0" max="6000" step="100" value="2000" aria-label="Mountain elevation in metres"><div class="elevation-scale"><span>Valley<br>0 m</span><span>Tree line<br>~3,000 m*</span><span>High alpine<br>6,000 m</span></div><div class="elevation-scene"><div class="elevation-marker" id="elevation-marker"><span>YOU ARE HERE</span><i></i></div><div class="elev-zone zone-valley"><span>01</span><strong>Foothill</strong></div><div class="elev-zone zone-forest"><span>02</span><strong>Forest</strong></div><div class="elev-zone zone-alpine"><span>03</span><strong>Alpine</strong></div><div class="elev-zone zone-nival"><span>04</span><strong>Nival</strong></div></div><div class="elevation-description"><span class="lab-description-index" id="elevation-index">ZONE 02</span><div><h3 id="elevation-subtitle">Montane forests</h3><p id="elevation-description">Cooler air, forest canopies and diverse understory habitats often dominate suitable middle elevations.</p></div><span class="elevation-disclaimer">*Illustrative, not universal</span></div></div></section>
    <% } %>

    <div class="article-layout" id="article-body">
      <aside class="article-rail"><div class="rail-sticky"><span class="rail-heading">ON THIS PAGE</span><% if (article.toc.length) { %><nav class="toc-nav" aria-label="On this page"><% article.toc.forEach((item) => { %><a href="#<%= item.id %>" class="toc-link toc-level-<%= item.level %>"><%= item.title %></a><% }); %></nav><% } else { %><p class="rail-muted">A short field note. Read at your own pace.</p><% } %><div class="rail-divider"></div><span class="rail-heading">KEEP EXPLORING</span><a class="rail-feature" href="/field-guide"><img src="<%= imageSrc('field-guide.svg') %>" data-image-fallback="/img/field-guide.svg" alt="" loading="lazy"><span><strong>Field guide</strong><small>Observe with intention ↗</small></span></a><a class="rail-feature" href="/references"><img src="<%= imageSrc('references.svg') %>" data-image-fallback="/img/references.svg" alt="" loading="lazy"><span><strong>References</strong><small>Read beyond the atlas ↗</small></span></a></div></aside>
      <article class="prose article-prose"><div class="prose-lede"><span class="lede-symbol">✳</span><p><%= page.description %></p></div><%- article.html %><div class="article-endmark">✳ <span>END OF FIELD NOTE</span> ✳</div><div class="article-feedback"><span>Was this useful?</span><button type="button" data-feedback="helpful">Yes, thank you ↗</button><button type="button" data-feedback="research">I want to go deeper ↗</button></div></article>
    </div>

    <% if (typeof relatedPages !== 'undefined' && Array.isArray(relatedPages) && relatedPages.length) { %><section class="related-section"><div class="section-heading"><div><span class="section-index">FOLLOW THE THREAD</span><h2>Keep <em>exploring.</em></h2></div><a class="text-link" href="/world-ranges">View all topics <span>→</span></a></div><div class="related-grid"><% relatedPages.forEach((item) => { %><a class="related-card" href="/<%= item.slug %>"><img src="<%= imageSrc(item.image) %>" data-image-fallback="/img/<%= item.slug %>.svg" alt="" loading="lazy"><span class="small-label"><%= item.category.toUpperCase() %></span><h3><%= item.title %></h3><p><%= item.description %></p><span class="inline-arrow">Read field note ↗</span></a><% }); %></div></section><% } %>
  </div>
  <%- include('../partials/footer') %>
</main>
<%- include('../partials/layout-end') %>
