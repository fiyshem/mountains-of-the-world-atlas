<%- include('../partials/head', { page }) %>
<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<main class="main-content article-main" id="main-content"><div class="article-shell glossary-shell">
  <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Reference / Glossary</span></div>
  <header class="page-masthead glossary-masthead reveal"><div class="masthead-copy"><span class="article-eyebrow"><span class="kicker-line"></span> A–Z / THE LANGUAGE OF MOUNTAINS</span><h1>Words that help<br>you <em>read the land.</em></h1><p class="article-deck">Clear definitions for the geological, ecological and climate terms that turn mountain observations into understanding.</p></div><div class="masthead-art"><img src="<%= imageSrc('glossary.svg') %>" data-image-fallback="/img/glossary.svg" alt="An illustrated mountain landscape representing mountain science vocabulary"><span>FIELD VOCABULARY / EDITION 01</span></div></header>
  <div class="glossary-tools reveal"><div class="glossary-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg><label for="glossary-search" class="sr-only">Filter glossary terms</label><input type="search" id="glossary-search" placeholder="Search a word or definition…"></div><span id="glossary-count"><%= glossary.length %> terms</span></div>
  <div class="glossary-layout"><nav class="glossary-letters" aria-label="Jump to letter"><% ['A','B','C','E','F','G','H','L','M','N','O','P','R','S','T','W'].forEach((letter)=> { %><a href="#letter-<%= letter %>"><%= letter %></a><% }); %></nav><section class="glossary-entries" id="glossary-entries"><% let lastLetter=''; glossary.slice().sort((a,b)=>a[0].localeCompare(b[0])).forEach((item)=> { const letter=item[0][0].toUpperCase(); if(letter!==lastLetter){lastLetter=letter; %><div class="glossary-letter-heading" id="letter-<%= letter %>"><%= letter %></div><% } %><article class="glossary-entry reveal" data-term="<%= (item[0]+' '+item[1]).toLowerCase() %>" id="term-<%= item[0].toLowerCase().replace(/[^a-z0-9]+/g,'-') %>"><div class="glossary-term-letter"><%= letter %></div><div><h2><%= item[0] %></h2><p><%= item[1] %></p></div><button type="button" class="term-copy" aria-label="Copy term: <%= item[0] %>" data-copy-text="<%= item[0] %>: <%= item[1] %>">↗</button></article><% }); %><div id="glossary-no-results" class="no-results" hidden><h2>No matching term yet.</h2><p>Try another word or browse the letter index.</p></div></section></div>
  <div class="glossary-bottom-note"><span>✳</span><p>Definitions are concise learning aids. Scientific terms can have more specific meanings in specialist publications; consult the reference library for further detail.</p><a href="/references">Reference library ↗</a></div>
</div><%- include('../partials/footer') %></main>
<%- include('../partials/layout-end') %>
