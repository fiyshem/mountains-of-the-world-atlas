<%- include('../partials/head', { page }) %>
<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<main class="main-content article-main" id="main-content"><div class="article-shell search-shell">
  <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Search</span></div>
  <header class="search-heading reveal"><span class="article-eyebrow"><span class="kicker-line"></span> THE MOUNTAIN KNOWLEDGE INDEX</span><h1>Find your <em>next question.</em></h1><p>Search across regional studies, ecological themes, field skills and reference pages.</p><form class="large-search-form" action="/search" method="get"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg><label for="site-query" class="sr-only">Search all mountain topics</label><input id="site-query" name="q" type="search" value="<%= q %>" placeholder="Try: glaciers, alpine birds, tectonic plates…" autofocus><button class="button button-primary" type="submit">Search <span>→</span></button></form></header>
  <% if (q) { %><section class="search-results-block"><div class="results-topline"><span class="section-index">RESULTS FOR “<%= q %>”</span><span><%= results.length %> page<%= results.length===1?'':'s' %> found</span></div><% if (results.length) { %><div class="search-result-list"><% results.forEach((result,index)=> { %><a href="/<%= result.slug %>" class="search-result reveal"><span class="result-index"><%= String(index+1).padStart(2,'0') %></span><div class="result-image"><img src="<%= imageSrc(result.image) %>" data-image-fallback="/img/<%= result.slug %>.svg" alt="" loading="lazy"></div><div class="result-copy"><span class="small-label"><%= result.eyebrow %> · <%= result.category.toUpperCase() %></span><h2><%= result.title %></h2><p><%= result.description %></p></div><div class="result-count"><span><%= result.count %></span><small>mentions</small><b>↗</b></div></a><% }); %></div><% } else { %><div class="no-results"><div>⌕</div><h2>No trail found for that phrase.</h2><p>Try a broader word such as “forest”, “water”, “climate” or “mountains”.</p><a class="button button-outline" href="/world-ranges">Browse the atlas instead</a></div><% } %></section><% } else { %><section class="suggested-searches reveal"><span class="section-index">GOOD PLACES TO START</span><div class="suggested-chip-row"><a href="/search?q=glacier">Glaciers & snow</a><a href="/search?q=tree line">Tree line</a><a href="/search?q=snow leopard">Snow leopard</a><a href="/search?q=erosion">Erosion</a><a href="/search?q=conservation">Conservation</a><a href="/search?q=forest">Mountain forests</a></div></section><% } %>
</div><%- include('../partials/footer') %></main>
<%- include('../partials/layout-end') %>
