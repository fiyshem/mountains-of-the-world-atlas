<%- include('../partials/head', { page }) %>
<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<main class="main-content article-main" id="main-content"><div class="article-shell range-page-shell">
  <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>World atlas</span></div>
  <header class="page-masthead reveal"><div class="masthead-copy"><span class="article-eyebrow"><span class="kicker-line"></span> 02 / THE GLOBAL ATLAS</span><h1>Different ranges.<br><em>One living planet.</em></h1><p class="article-deck">Follow the mountain belts that shape continents, weather and life. Explore a region to uncover its geology, habitats and ecological character.</p></div><div class="masthead-art"><img src="<%= imageSrc('world-ranges.svg') %>" data-image-fallback="/img/world-ranges.svg" alt="Layered ranges in a wide mountain landscape"><span>AN ATLAS OF PLACE & PROCESS</span></div></header>
  <section class="range-intro prose reveal"><%- intro.html %></section>
  <section class="range-explorer-section"><div class="section-heading reveal"><div><span class="section-index">REGIONAL STUDIES</span><h2>Choose a <em>mountain world.</em></h2></div><p>Filter by broad geographic region or browse the complete collection.</p></div><div class="filter-row reveal"><div class="filter-pills" role="group" aria-label="Filter mountain ranges"><button class="filter-pill is-active" type="button" data-region-filter="all" aria-pressed="true">All regions <span><%= rangeCards.length %></span></button><button class="filter-pill" type="button" data-region-filter="Asia" aria-pressed="false">Asia</button><button class="filter-pill" type="button" data-region-filter="Europe" aria-pressed="false">Europe</button><button class="filter-pill" type="button" data-region-filter="North America" aria-pressed="false">North America</button><button class="filter-pill" type="button" data-region-filter="South America" aria-pressed="false">South America</button><button class="filter-pill" type="button" data-region-filter="Africa" aria-pressed="false">Africa</button><button class="filter-pill" type="button" data-region-filter="Oceania" aria-pressed="false">Oceania</button></div><span id="range-count" class="range-count"><%= rangeCards.length %> regional studies</span></div>
  <div class="range-card-grid range-card-grid-large" id="range-grid"><% rangeCards.forEach((range, index) => { %><a href="/<%= range.slug %>" class="range-card reveal" data-region="<%= range.region %>" data-range-name="<%= range.name.toLowerCase() %>"><div class="range-card-image"><img loading="lazy" src="<%= imageSrc(range.image) %>" data-image-fallback="/img/<%= range.slug %>.svg" alt="Illustrated landscape representing the <%= range.name %>"><span class="range-card-count"><%= String(index+1).padStart(2,'0') %></span><span class="range-card-open">↗</span></div><div class="range-card-body"><div class="range-meta"><span><%= range.region.toUpperCase() %></span><span><%= range.stat %></span></div><h3><%= range.name %></h3><p><%= range.note %></p><span class="inline-arrow">Explore region ↗</span></div></a><% }); %></div><div class="empty-filter" id="range-empty" hidden>No ranges are tagged with that exact region yet. Choose “All regions” to see the full atlas.</div></section>
  <section class="range-note reveal"><div class="note-symbol">✳</div><div><span class="section-index">A NOTE ON GEOGRAPHY</span><h2>Boundaries are <em>useful, not absolute.</em></h2><p>Mountain systems may span countries, climate zones and biogeographic regions. Regional labels in this atlas are broad learning aids rather than precise scientific boundaries.</p></div></section>
</div><%- include('../partials/footer') %></main>
<%- include('../partials/layout-end') %>
